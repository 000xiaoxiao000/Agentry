{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentry",
  "version": "0.2.0",
  "identifier": "com.example.agentry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentry",
        "width": 1400,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
